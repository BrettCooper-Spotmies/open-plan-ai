# API Configuration (legacy REST; app data uses Supabase when VITE_USE_SUPABASE is not false)
VITE_API_BASE_URL=http://localhost:3000/api

# Data Source
VITE_USE_MOCK_DATA=false
VITE_USE_SUPABASE=true

# Supabase (required for production builds)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# New dashboard keys use publishable; legacy anon key also works:
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# implicit = hash-based recovery links (default). pkce = recommended OAuth-style flow when redirects use ?code=
VITE_SUPABASE_AUTH_FLOW=implicit

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# App Configuration
VITE_APP_NAME=Open Plan AI
VITE_APP_VERSION=1.0.0
