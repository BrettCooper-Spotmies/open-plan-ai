#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged for linting
echo "📝 Linting staged files..."
npx lint-staged

# Run type-check
echo "🔎 Type checking..."
npm run type-check

# Run tests
echo "🧪 Running tests..."
npm run test -- --run

echo "✅ All checks passed!"
